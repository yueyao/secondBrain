{
  "name": "secondbrain-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "secondBrain 服务端 monorepo：领域 / 契约 / 适配器 / 应用 / 入口",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "boundaries": "node tools/check-boundaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node tools/check-boundaries.mjs && node scripts/check-docs.mjs && tsc --noEmit -p tsconfig.json && depcruise packages --config .dependency-cruiser.cjs && vitest run",
    "demo": "pnpm --filter @sb/server start",
    "check:model": "tsx scripts/check-model-config.ts",
    "demo:deepseek": "MODEL_BASE_URL=${MODEL_BASE_URL:-https://api.deepseek.com} MODEL_CONFIG=config/model-profiles.json pnpm --filter @sb/server start",
    "docs:check": "node scripts/check-docs.mjs",
    "baseline": "tsx scripts/baseline.ts",
    "import:dry-run": "tsx scripts/import-dry-run.ts",
    "import:apply": "tsx scripts/import-apply.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "worker:once": "WORKER_ONCE=1 tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
