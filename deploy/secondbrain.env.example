# 服务端环境变量（复制到 /etc/secondbrain/secondbrain.env，chmod 600）
DATA_DIR=/srv/secondbrain/state
VAULT_ROOT=/srv/secondbrain/vault
PORT=8787

# 模型（DeepSeek flash 默认）
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-me
MODEL_CONFIG=/srv/secondbrain/repo/config/model-profiles.json
LONG_TEXT_THRESHOLD=200000

# worker
WORKER_INTERVAL_MS=300000
WORKER_MAX_JOBS=5

# 额外镜像（可选，需可写凭据；GitHub 已是 origin 时无需设置）
# MIRROR_VAULT_REMOTE=mirror
# MIRROR_RAW_REMOTE=mirror
