[Unit]
Description=secondBrain worker（自动 ingest + 起草，不自动入库）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secondbrain
WorkingDirectory=/srv/secondbrain/repo
EnvironmentFile=/etc/secondbrain/secondbrain.env
ExecStart=/usr/bin/pnpm --filter @sb/worker start
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
