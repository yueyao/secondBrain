{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@sb/domain": ["packages/domain/src/index.ts"],
      "@sb/domain/*": ["packages/domain/src/*"],
      "@sb/contracts": ["packages/contracts/src/index.ts"],
      "@sb/contracts/*": ["packages/contracts/src/*"]
    }
  }
}
