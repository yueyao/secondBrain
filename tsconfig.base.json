{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@sb/domain": [
        "packages/domain/src/index.ts"
      ],
      "@sb/domain/*": [
        "packages/domain/src/*"
      ],
      "@sb/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@sb/contracts/*": [
        "packages/contracts/src/*"
      ],
      "@sb/adapters-sqlite": [
        "packages/adapters-sqlite/src/index.ts"
      ],
      "@sb/adapters-sqlite/*": [
        "packages/adapters-sqlite/src/*"
      ],
      "@sb/adapters-vault": [
        "packages/adapters-vault/src/index.ts"
      ],
      "@sb/adapters-vault/*": [
        "packages/adapters-vault/src/*"
      ],
      "@sb/adapters-search-memory": [
        "packages/adapters-search-memory/src/index.ts"
      ],
      "@sb/adapters-search-memory/*": [
        "packages/adapters-search-memory/src/*"
      ],
      "@sb/testing": [
        "packages/testing/src/index.ts"
      ],
      "@sb/testing/*": [
        "packages/testing/src/*"
      ],
      "@sb/app": [
        "packages/app/src/index.ts"
      ],
      "@sb/app/*": [
        "packages/app/src/*"
      ]
    }
  }
}
